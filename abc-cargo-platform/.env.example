# Copy to .env (never commit .env)
NODE_ENV=production
PORT=4000
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_TTL=12h
DB_FILE=./data/abc-cargo.db
ADMIN_EMAIL=admin@yourcompany.example
ADMIN_PASSWORD=ChangeMe123
TRUST_PROXY=1
PAYMENTS_DEMO=0
SEED_DEMO=0
LOGIN_RATE_LIMIT=20
MAP_TILE_HOSTS=https://tile.openstreetmap.org
# Domain decides the region at login (no region picker). Sub-domains (erp.abccargo.uk) match too.
# Add India when its domain is known, e.g. abccargo.in=IN. Other hosts (localhost, demo) use each account's own region.
REGION_DOMAINS=abccargo.ae=AE,abccargo.uk=GB,abccargogcc.com=SA,abccargo.com=GROUP
